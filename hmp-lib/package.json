{
  "name": "hmp-lib",
  "version": "0.8.1",
  "author": "HogwartsMP",
  "description": "Shared, dependency-free server and client utilities for HogwartsMP resources.",
  "license": "SEE LICENSE IN LICENSE",
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": [
      "text",
      "number",
      "position",
      "validation",
      "rateLimit",
      "locale",
      "logger",
      "input",
      "config",
      "player",
      "command"
    ],
    "errorBehavior": "stop",
    "priority": -900
  }
}
