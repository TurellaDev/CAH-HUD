{
  "name": "hmp-inventory",
  "version": "0.8.1",
  "author": "HogwartsMP",
  "description": "Character-scoped custom items and a unified Hogwarts Legacy inventory for HogwartsMP.",
  "license": "SEE LICENSE IN LICENSE",
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js",
      "dist/index.html",
      "dist/fonts/**",
      "dist/icons/**"
    ],
    "exports": [
      "items",
      "inventory",
      "containers",
      "transfers",
      "native",
      "ui",
      "status"
    ],
    "resourceDependencies": [
      {
        "name": "hmp-mysql",
        "version": "0.8.1"
      },
      {
        "name": "hmp-core",
        "version": "0.8.1"
      },
      {
        "name": "hmp-lib",
        "version": "0.8.1"
      }
    ],
    "errorBehavior": "stop",
    "priority": -725
  }
}
