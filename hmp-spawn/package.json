{
  "name": "hmp-spawn",
  "version": "0.8.0",
  "author": "HogwartsMP",
  "description": "Character-scoped spawn selection and last-location persistence for HogwartsMP.",
  "license": "SEE LICENSE IN LICENSE",
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
