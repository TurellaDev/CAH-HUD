      "dist/client.js",
      "dist/index.html"
    ],
    "exports": [
      "locations",
      "ui",
      "spawn",
      "status"
    ],
    "resourceDependencies": [
      {
        "name": "hmp-characters",
        "version": "0.8.0"
      },
      {
        "name": "hmp-core",
        "version": "0.8.0"
      },
      {
        "name": "hmp-lib",
        "version": "0.8.0"
      }
    ],
    "errorBehavior": "stop",
    "priority": -600
  }
