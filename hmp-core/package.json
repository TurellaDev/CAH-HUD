{
  "name": "hmp-core",
  "version": "0.8.0",
  "author": "HogwartsMP",
  "description": "Persistent account, identity, character, group and metadata foundations for HogwartsMP servers.",
  "license": "SEE LICENSE IN LICENSE",
  "mafiahub": {
    "serverScripts": [
      "dist/main.js"
    ],
    "clientScripts": [
      "dist/client.js"
    ],
    "files": [
      "dist/client.js"
    ],
    "exports": [
      "status",
      "identity",
      "accounts",
      "sessions",
      "characters",
      "groups",
      "metadata"
    ],
    "resourceDependencies": [
      {
        "name": "hmp-mysql",
        "version": "0.8.0"
      },
      {
        "name": "hmp-lib",
        "version": "0.8.0"
      }
    ],
    "errorBehavior": "stop",
    "priority": -800
  }
}
